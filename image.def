Bootstrap: oras
From: ghcr.io/g5t/stacktainer/ecdc:6.0

%arguments
plumber_version="0.23.0"
niess_version="0.9.1"
restage_version="0.15.0"
mcpl_version="2.2.8"
ncrystal_version="4.4.6"
readout_version="0.8.0"
mccode_tag="v3.8.7"
mcstas_chopper_lib_version="4.2.2"
cache_home="/opt/mccodeantlr-cache"
# kafka-to-nexus versions known to create files with SWMR_WRITE (see the shim in %post);
# only consulted by %test if file-maker cannot show it directly.
k2n_swmr_bad_versions="HEAD-232c717"
# kafka-to-nexus versions known to forward into a destroyed MessageWriter at the end of
# a job (see the teardown shim in %post); %test fails for any other version.
k2n_teardown_bad_versions="HEAD-232c717"

%post
set -eu

dnf install -y gcc g++ git uuid python3.12-pyyaml openmpi

python -m pip install \
  ephemeral-port-reserve \
  "niess=={{ niess_version }}" \
  "mccode-plumber=={{ plumber_version }}" \
  "restage=={{ restage_version }}" \
  "ncrystal=={{ ncrystal_version }}" \
  "mcpl=={{ mcpl_version }}"

# Kept separate so --only-binary applies to this package alone: it must come from
# a wheel (a source build would need cmake and conan), while the pure-Python
# packages above are happy either way.
python -m pip install --only-binary=:all: "mcstas-readout-master=={{ readout_version }}"

# ── kafka-to-nexus: create files without SWMR ────────────────────────────────
# The base image's kafka-to-nexus creates each file with H5F_ACC_SWMR_WRITE already
# set, writes the static structure, then closes and reopens it in SWMR mode. Past
# about 630 static datasets (BIFROST has ~3100) that leaves HDF5 1.14.5's metadata
# cache inconsistent: a debug HDF5 aborts at the reopen (file-maker shows it offline).
# Creating the file without the flag, and keeping the reopen, avoids it. Until the fix
# is in kafka-to-nexus, this preload shim drops the flag from H5Fcreate, and a wrapper
# takes the binary's place so every caller gets it. (This was first blamed for the
# writer's crash at the end of a job; that turned out to be the teardown bug below.)
mkdir -p /opt/k2n-swmr-fix
cat > /opt/k2n-swmr-fix/noswmr_create.c <<'SHIM'
/* LD_PRELOAD shim: create HDF5 files without H5F_ACC_SWMR_WRITE, so that kafka-to-nexus
 * builds each file in regular mode and only then reopens it for SWMR writing.
 * No HDF5 headers in the image, so the two definitions needed are copied from
 * HDF5 1.14's H5Ipublic.h and H5Fpublic.h.
 *
 * With NOSWMR_PROBE set it changes nothing and only reports, on stderr, whether the
 * caller asked for SWMR_WRITE: that is how the image's %test finds out whether the
 * shim is still needed. */
#define _GNU_SOURCE
#include <dlfcn.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

typedef int64_t hid_t;
#define H5F_ACC_SWMR_WRITE 0x0020u

hid_t H5Fcreate(const char *name, unsigned flags, hid_t fcpl, hid_t fapl) {
  static hid_t (*real)(const char *, unsigned, hid_t, hid_t) = 0;
  if (!real) real = (hid_t (*)(const char *, unsigned, hid_t, hid_t))dlsym(RTLD_NEXT, "H5Fcreate");
  if (getenv("NOSWMR_PROBE")) {
    fprintf(stderr, "noswmr_create: H5Fcreate %s SWMR_WRITE\n",
            (flags & H5F_ACC_SWMR_WRITE) ? "with" : "without");
    return real(name, flags, fcpl, fapl);
  }
  return real(name, flags & ~H5F_ACC_SWMR_WRITE, fcpl, fapl);
}
SHIM
gcc -O2 -shared -fPIC -o /opt/k2n-swmr-fix/noswmr_create.so /opt/k2n-swmr-fix/noswmr_create.c -ldl

# ── kafka-to-nexus: do not forward into a destroyed MessageWriter ────────────
# The writer's crash at the end of a job -- "malloc(): unsorted double linked list
# corrupted", the file left open -- is a use after destruction in kafka-to-nexus.
# ~StreamController destroys its MessageWriter (WriterThread) before its topics
# (Streamers), and each topic's SourceFilter forwards its buffered pre-start message
# from its destructor, into the destroyed writer's queue. mccode-plumber always stops
# with stop-now, which leaves the filters alive until then. About one back-to-back
# BIFROST job in four crashed; none with this shim (see BUG-kafka-to-nexus-crash-on-
# job-end.md in the mccode-compare workspace). The upstream fix is to declare
# WriterThread before Streamers.
# libfilewriter_lib.so makes both calls through its PLT, so a preload can interpose
# them: once the writer is destroyed, the shim drops buffered forwards -- which could
# never have been written, the writer's thread having been joined -- and the next
# job's H5Fcreate, made before its new writer exists, re-arms them.
mkdir -p /opt/k2n-teardown-fix
cat > /opt/k2n-teardown-fix/teardown_fix.c <<'SHIM'
/* LD_PRELOAD shim: stop kafka-to-nexus's SourceFilters forwarding into a destroyed
 * MessageWriter at the end of a job. See image.def's %post. Each teardown that dropped
 * anything is reported once, on stderr or, if $K2N_TEARDOWN_LOG is set, in that file. */
#define _GNU_SOURCE
#include <dlfcn.h>
#include <stdatomic.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

typedef int64_t hid_t;

static atomic_int writer_gone = 0;
static atomic_long dropped = 0;

static void report(long n) {
  if (n <= 0) return;
  const char *path = getenv("K2N_TEARDOWN_LOG");
  FILE *f = path ? fopen(path, "a") : stderr;
  if (!f) return;
  fprintf(f, "k2n-teardown-fix: the last job's teardown dropped %ld buffered "
             "forward(s) into its destroyed MessageWriter\n", n);
  if (path) fclose(f);
}

/* Stream::MessageWriter::~MessageWriter() */
void _ZN6Stream13MessageWriterD1Ev(void *self) {
  static void (*real)(void *) = 0;
  if (!real) real = (void (*)(void *))dlsym(RTLD_NEXT, "_ZN6Stream13MessageWriterD1Ev");
  real(self);
  atomic_store(&writer_gone, 1);
}

/* Stream::SourceFilter::forward_buffered_message() */
void _ZN6Stream12SourceFilter24forward_buffered_messageEv(void *self) {
  static void (*real)(void *) = 0;
  if (atomic_load(&writer_gone)) {
    atomic_fetch_add(&dropped, 1);
    return;
  }
  if (!real) real = (void (*)(void *))dlsym(RTLD_NEXT, "_ZN6Stream12SourceFilter24forward_buffered_messageEv");
  real(self);
}

/* A job creates its file before its MessageWriter exists: re-arm here. Chains with the
 * SWMR shim, which wraps H5Fcreate too. */
hid_t H5Fcreate(const char *name, unsigned flags, hid_t fcpl, hid_t fapl) {
  static hid_t (*real)(const char *, unsigned, hid_t, hid_t) = 0;
  if (!real) real = (hid_t (*)(const char *, unsigned, hid_t, hid_t))dlsym(RTLD_NEXT, "H5Fcreate");
  report(atomic_exchange(&dropped, 0));
  atomic_store(&writer_gone, 0);
  return real(name, flags, fcpl, fapl);
}

__attribute__((destructor)) static void report_at_exit(void) {
  report(atomic_load(&dropped));
}
SHIM
gcc -O2 -Wall -shared -fPIC -o /opt/k2n-teardown-fix/teardown_fix.so /opt/k2n-teardown-fix/teardown_fix.c -ldl

mv /kafka-to-nexus/bin/kafka-to-nexus /kafka-to-nexus/bin/kafka-to-nexus.real
cat > /kafka-to-nexus/bin/kafka-to-nexus <<'WRAP'
#!/bin/sh
# kafka-to-nexus, with HDF5 files created without SWMR (/opt/k2n-swmr-fix) and no
# forwarding into a destroyed MessageWriter at the end of a job (/opt/k2n-teardown-fix)
export LD_PRELOAD=/opt/k2n-swmr-fix/noswmr_create.so:/opt/k2n-teardown-fix/teardown_fix.so${LD_PRELOAD:+:$LD_PRELOAD}
exec /kafka-to-nexus/bin/kafka-to-nexus.real "$@"
WRAP
chmod 0755 /kafka-to-nexus/bin/kafka-to-nexus

echo "export MCCODEANTLR_FLAGS__MCPL='$(mcpl-config --show buildflags)'" >> $APPTAINER_ENVIRONMENT
echo "export MCCODEANTLR_FLAGS__NCRYSTAL='$(ncrystal-config --show buildflags)'" >> $APPTAINER_ENVIRONMENT

# ── mccode-antlr cache ────────────────────────────────────────────────────────
# Built into the image so a run needs no network. It has to live outside $HOME:
# Apptainer bind-mounts the host home over the image's, so a cache under ~/.cache
# would be invisible at runtime. XDG_CACHE_HOME is the only lever that moves it --
# pooch resolves it through platformdirs and mccode-antlr exposes no setting of
# its own.
export XDG_CACHE_HOME={{ cache_home }}

# One list, used by both passes. `populate` downloads; `ir-build` only parses what
# is already on disk, so the same registries must be named to both.
REGISTRIES="\
 -R mcdotstar/mcstas-chopper-lib@v{{ mcstas_chopper_lib_version }}\
 -R mcdotstar/mccode-mcpl-filter@main\
 -R mcdotstar/mcstas-detector-cubes@main\
 -R mcdotstar/mcstas-detector-tubes@main\
 -R mcdotstar/mcstas-epics-link@main\
 -R mcdotstar/mcstas-frame-tof-monitor@main\
 -R mcdotstar/mcstas-monochromator-rowland@main\
 -R mcdotstar/mcstas-radial-filter-collimator@main\
 -R mcdotstar/mcstas-slit-radial@main\
 -R mcdotstar/mcstas-transformer@main"

mccode-antlr cache populate --tag {{ mccode_tag }} --flavor mcstas $REGISTRIES
mccode-antlr cache ir-build -j --tag {{ mccode_tag }} --flavor mcstas $REGISTRIES

# ── splitrun-cache-seed ───────────────────────────────────────────────────────
# The image cache is read-only. mccode-antlr degrades gracefully against that --
# it warns and re-fetches rather than failing -- but anyone adding their own
# registry, or wanting the IR cache to persist, needs a writable copy. This makes
# one, and prints its path so a modulefile can do
#     setenv XDG_CACHE_HOME [exec splitrun-cache-seed]
cat > /usr/local/bin/splitrun-cache-seed <<'SEED'
#!/bin/sh
# Seed a writable copy of this image's mccode-antlr cache.
#
# Prints the resulting directory on stdout -- use it as XDG_CACHE_HOME. All
# progress reporting goes to stderr so that
#     XDG_CACHE_HOME=$(splitrun-cache-seed)
# does the right thing.
set -eu

IMAGE_CACHE='@CACHE_HOME@'
BUILD_STAMP='@BUILD_STAMP@'
STAMP=.splitrun-cache-stamp

usage() {
    cat <<USAGE
Usage: splitrun-cache-seed [-q] [-f] [TARGET]

Copy the image's mccode-antlr cache to TARGET and print TARGET.

  TARGET   default: \$SPLITRUN_CACHE_HOME, else \$HOME/.cache/splitrun
  -q       no progress messages
  -f       re-copy even if TARGET is already seeded from this image
  -h       this message

The copy is additive: registries you have added to TARGET yourself are left
alone, image-provided ones are refreshed.
USAGE
}

quiet=0; force=0; target=''
while [ $# -gt 0 ]; do
    case "$1" in
        -q|--quiet) quiet=1 ;;
        -f|--force) force=1 ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) printf 'splitrun-cache-seed: unknown option %s\n' "$1" >&2; usage >&2; exit 2 ;;
        *) target=$1 ;;
    esac
    shift
done
if [ $# -gt 0 ]; then target=$1; fi

if [ -z "$target" ]; then
    target=${SPLITRUN_CACHE_HOME:-${HOME:-/tmp}/.cache/splitrun}
fi

say() { [ "$quiet" -eq 1 ] || printf 'splitrun-cache-seed: %s\n' "$*" >&2; }

if [ ! -d "$IMAGE_CACHE" ]; then
    printf 'splitrun-cache-seed: no cache at %s in this image\n' "$IMAGE_CACHE" >&2
    exit 1
fi

if [ "$force" -eq 0 ] && [ -f "$target/$STAMP" ] \
   && [ "$(cat "$target/$STAMP")" = "$BUILD_STAMP" ]; then
    say "already seeded: $target"
else
    say "seeding from $IMAGE_CACHE into $target"
    mkdir -p "$target"
    cp -a "$IMAGE_CACHE/." "$target/"
    printf '%s\n' "$BUILD_STAMP" > "$target/$STAMP"
    say 'done'
fi

printf '%s\n' "$target"
SEED

sed -i "s|@CACHE_HOME@|{{ cache_home }}|; \
        s|@BUILD_STAMP@|{{ mccode_tag }} $(python -c 'import mccode_antlr.version as v; print(v.version())' 2>/dev/null || echo unknown)|" \
    /usr/local/bin/splitrun-cache-seed
chmod 0755 /usr/local/bin/splitrun-cache-seed

dnf clean all

%environment
export LC_ALL=C
export RESTAGE_FIXED=${RESTAGE_FIXED:-''}
export MCCODEANTLR_MCCODE_POOCH__TAG={{ mccode_tag }}
export MPI_COMPILER=openmpi-x86_64
export LD_LIBRARY_PATH=/usr/lib64/openmpi/lib:/event-formation-unit/lib:/.singularity.d/libs
export MANPATH=/usr/share/man/openmpi-x86_64:/usr/share/man
export MPI_INCLUDE=/usr/include/openmpi-x86_64
export MPI_MAN=/usr/share/man/openmpi-x86_64
export PKG_CONFIG_PATH=/usr/lib64/openmpi/lib/pkgconfig
export MPI_PYTHON3_SITEARCH=/usr/lib64/python3.9/site-packages/openmpi
export MPI_HOME=/usr/lib64/openmpi
export MPI_FORTRAN_MOD_DIR=/usr/lib64/gfortran/modules/openmpi
export MPI_SUFFIX=_openmpi
export MPI_SYSCONFIG=/etc/openmpi-x86_64
export MPI_LIB=/usr/lib64/openmpi/lib
export PATH=/usr/lib64/openmpi/bin:$PATH
export MPI_BIN=/usr/lib64/openmpi/bin

# The host home is bind-mounted over the image's, so a host ~/.local
# site-packages would shadow what is installed here. Keep it out.
export PYTHONNOUSERSITE=1
# The in-image cache. Override it -- see splitrun-cache-seed -- to get a writable
# one; the image environment wins over the host's, but --env still beats both.
export XDG_CACHE_HOME={{ cache_home }}

%labels
McCodeTag {{ mccode_tag }}
CacheHome {{ cache_home }}

%help
Data collection utilities for the European Spallation Source.
Event Formation Unit binaries:
	bifrost  - the indirect geometry time-of-flight spectrometer, BIFROST
	cbm      - beam monitors used a multiple instruments
	cspec    - the direct geometry time-of-flight spectrometer, CSPEC
	dream    - the powder diffractometer, DREAM
	freia    - the reflectometer, FREIA
	loki     - the small angle scattering diffractometer, LOKI
	miracles - the back scattering time-of-flight spectrometer, MIRACLES
	nmx      - the macromollecular single crystal diffractometer, NMX
	timepix3 - the TimePix3 clustering photon imaging detector, used at ODIN
	trex     - the direct geometry time-of-flight spectrometer, TREX
File Writer binaries:
	kafkfa-to-nexus - the worker responsible for writing streams to NeXus files
Readout utilities:
	readout-config        - Retrieve information needed to use the McStas-to-EFU Readout Master Module mechanism
	readout-replay        - Read and resend stored weighted neutron rays following a McStas simulation
McCode Plumber programs:
	mc-epics              - Configure and run an EPICS mailbox server to host instrument setting parameter value updates 
	mp-epics-update       - Send 'key value' pair updates to a running EPICS mailbox server
	mp-forwarder-setup    - Inform the Forwarder which instrument setting parameters should be forwarded to Kafka
	mp-forwarder-teardown - Inform the Forwarder to stop sending instrument setting parameter updates
	mp-insert-hdf5-instr  - Add a serialized form of the provided instrument to a new or existing HDF5 file
	mp-register-topics    - Ensure that the specified stream topic names exist on a configurable Kafka service
	mp-splitrun           - Use 'restage.splitrun' with McCode histogram (monitor) sending callbacks for Kafka integration
	mp-writer-from        - Print the current time as needed to specify, e.g., the start time in a call to 'mp-writer-write'
	mp-writer-kill        - Send a File Writer command to stop a specified job
	mp-writer-killall     - Send a File Writer command to stop all jobs
	mp-writer-list        - List known File Writer jobs
	mp-writer-wait        - Sleep until the specified File Writer job has finished
	mp-writer-write       - Send a File Writer command to start a job, controlling start and optionally stop time
	mp-nexus-splitrun     - The orchestrated NeXus producing version of mp-splitrun
	mp-nexus-services     - Load-in, wait, load-out for EFU, Forwarder, Writer services
        mp-nexus-collect-replay - Replay collected readouts/parameters to waiting services
MCPL binaries:
	mcpltool              - tool for examining and modifying Monte Carlo Particle List (MCPL) file(s)
	mcpl-config           - configuration information for the MCPL installation
NCrystal binaries:
	ncrystal_mcstasunion  - tool to construct material descriptions for McStas or McStasScript
	ncrystal_*            - too numerous to enumerate here, see homepage
	ncrystal-config       - configuration information for the NCrystal installation 
Cache utilities:
	splitrun-cache-seed   - Copy this image's mccode-antlr cache somewhere writable and print where

The McCode components and their parsed intermediate representation are built into
the image, so translating an instrument needs no network. The cache is read-only,
which mccode-antlr tolerates -- it warns and re-fetches rather than failing -- but
to add your own component registry, or to keep the IR cache between runs, seed a
writable copy:

	apptainer exec {this}.sif splitrun-cache-seed
	apptainer exec --env XDG_CACHE_HOME=$HOME/.cache/splitrun {this}.sif mp-splitrun ...

or, from a modulefile,

	setenv XDG_CACHE_HOME [exec splitrun-cache-seed]

splitrun-cache-seed prints the directory on stdout and everything else on stderr,
so it can be captured directly. It is idempotent, and re-seeding leaves registries
you added yourself alone.

Inspect what is cached with `mccode-antlr cache list -l` and
`mccode-antlr cache ir-list -l`.


%test
function test_revision(){
  expected="$2"
  for b in "${@:3}"
  do
    echo -n "Check $b version ... "
    res=$($b --version)
    if (echo $res | grep -q "${expected}")
    then
       echo "success!"
    else
       echo "${expected} not in $res"
       return 1
    fi
  done
}
function test_help(){
  res=0
  for b in "${@}"
  do
    echo -n "Check that ${b} provides '--help' ... "
    ret=$($b --help)
    exc=$?
    test $exc -eq 0 && echo "yes!" || echo "no!"
    res=$exc||$res
  done
  return $res
}
test_result=0
#test_revision $(echo ${EFU_VERSION} | tr '-' ' ')  bifrost cbm cspec dream freia loki miracles nmx timepix3 trex || test_result=1
test_revision Readout {{ readout_version }} readout-config || test_result=1
test_revision MCPL {{ mcpl_version }} mcpl-config || test_result=1
test_revision NCrystal {{ ncrystal_version }} ncrystal-config || test_result=1
#test_revision $(echo ${WRITER_VERSION} | tr '-' ' ') kafka-to-nexus || test_result=1
test_help file-maker template-maker readout-replay || test_result=1

# The Python packages that have to agree with each other. restage is pinned as well as
# mccode-plumber because plumber accepts an older restage that would set chopper knobs
# under names a niess-built instrument no longer declares.
function test_package(){
  echo -n "Check $1 is $2 ... "
  found=$(python -c "from importlib.metadata import version; print(version('$1'))" 2>&1)
  test "${found}" = "$2" && echo "yes!" || { echo "no: ${found}"; return 1; }
}
test_package niess {{ niess_version }} || test_result=1
test_package restage {{ restage_version }} || test_result=1
test_package mccode-plumber {{ plumber_version }} || test_result=1

# The kafka-to-nexus SWMR shim (see %post). First that it works: a file asked for with
# SWMR_WRITE is created without it when the shim is preloaded, and with it otherwise --
# so the copied flag value matches this HDF5. Then that the wrapper loads it.
cat > /tmp/swmr-intent.py <<'PY'
import ctypes, os, sys, tempfile
hdf5 = ctypes.CDLL('/kafka-to-nexus/lib/libhdf5.so.310', mode=ctypes.RTLD_GLOBAL)
glob = ctypes.CDLL(None)  # H5Fcreate as the writer sees it: the shim's, if preloaded
hid_t = ctypes.c_int64  # ids are 64-bit; ctypes would truncate them to int by default
hdf5.H5Pcreate.restype = glob.H5Fcreate.restype = hid_t
hdf5.H5open()
fapl = hdf5.H5Pcreate(hid_t.in_dll(hdf5, 'H5P_CLS_FILE_ACCESS_ID_g'))
LATEST = 3  # H5F_LIBVER_V114; SWMR needs the latest file format
hdf5.H5Pset_libver_bounds(hid_t(fapl), LATEST, LATEST)
path = os.path.join(tempfile.mkdtemp(), 'swmr.h5')
fid = glob.H5Fcreate(path.encode(), 0x0004 | 0x0020, hid_t(0), hid_t(fapl))  # EXCL|SWMR_WRITE
if fid < 0:
    sys.exit('H5Fcreate failed')
intent = ctypes.c_uint()
hdf5.H5Fget_intent(hid_t(fid), ctypes.byref(intent))
hdf5.H5Fclose(hid_t(fid))
print('swmr' if intent.value & 0x0020 else 'plain')
PY
echo -n "Check the shim creates HDF5 files without SWMR_WRITE ... "
with=$(LD_PRELOAD=/opt/k2n-swmr-fix/noswmr_create.so python /tmp/swmr-intent.py 2>&1)
without=$(python /tmp/swmr-intent.py 2>&1)
test "${with}" = plain -a "${without}" = swmr && echo "yes!" \
  || { echo "no: with shim '${with}', without '${without}'"; test_result=1; }
rm -f /tmp/swmr-intent.py
echo -n "Check kafka-to-nexus runs with the shim loaded ... "
LD_DEBUG=libs kafka-to-nexus --version 2>&1 | grep -q 'noswmr_create.so' && echo "yes!" \
  || { echo "no!"; test_result=1; }

# Is the shim still needed? file-maker builds a file through the same library code as
# the writer, so the shim's probe mode shows whether kafka-to-nexus still asks for
# SWMR_WRITE at creation. If it no longer does, this fails on purpose: delete the shim,
# its wrapper and these checks. Only if the probe cannot run is the version list used.
echo -n "Check the SWMR shim is still needed ... "
k2n_version=$(/kafka-to-nexus/bin/kafka-to-nexus.real --version 2>&1)
probe_dir=$(mktemp -d)
echo '{"children": [{"type": "group", "name": "entry", "children": [],
  "attributes": [{"name": "NX_class", "values": "NXentry"}]}]}' > "${probe_dir}/probe.json"
probe=$(cd "${probe_dir}" && NOSWMR_PROBE=1 LD_PRELOAD=/opt/k2n-swmr-fix/noswmr_create.so \
  timeout 60 file-maker -f probe.json -o probe.h5 2>&1 | grep -o 'H5Fcreate [a-z]* SWMR_WRITE' | head -1)
rm -rf "${probe_dir}"
case "${probe}" in
  "H5Fcreate with SWMR_WRITE")
    echo "yes! (${k2n_version} still creates files with SWMR_WRITE)" ;;
  "H5Fcreate without SWMR_WRITE")
    echo "no: ${k2n_version} creates files without SWMR_WRITE -- remove the shim"
    test_result=1 ;;
  *)
    if echo " {{ k2n_swmr_bad_versions }} " | grep -q " ${k2n_version} "; then
      echo "yes! (file-maker probe failed; ${k2n_version} is a known-bad version)"
    else
      echo "unknown: file-maker probe failed and ${k2n_version} is not a known-bad version"
      test_result=1
    fi ;;
esac

# The teardown shim (see %post). It can only work while libfilewriter_lib.so calls both
# functions it replaces through the PLT; a rebuild that binds them locally would leave it
# loaded and doing nothing, so check the relocations rather than trusting the load.
echo -n "Check kafka-to-nexus runs with the teardown shim loaded ... "
LD_DEBUG=libs kafka-to-nexus --version 2>&1 | grep -q 'teardown_fix.so' && echo "yes!" \
  || { echo "no!"; test_result=1; }
echo -n "Check the teardown shim can interpose what it replaces ... "
plt=$(readelf -rW /kafka-to-nexus/lib/libfilewriter_lib.so 2>/dev/null | grep JUMP_SLOT)
missing=""
for sym in _ZN6Stream13MessageWriterD1Ev _ZN6Stream12SourceFilter24forward_buffered_messageEv; do
  echo "${plt}" | grep -q " ${sym}" || missing="${missing} ${sym}"
done
test -z "${missing}" && echo "yes!" \
  || { echo "no: not called through the PLT:${missing}"; test_result=1; }

# Is the teardown shim still needed? That needs Kafka to show, so this goes by version:
# a kafka-to-nexus that is not known to have the bug fails, on purpose, until someone
# checks whether StreamController still destroys WriterThread before Streamers.
echo -n "Check the teardown shim is still needed ... "
if echo " {{ k2n_teardown_bad_versions }} " | grep -q " ${k2n_version} "; then
  echo "yes! (${k2n_version} is a known-bad version)"
else
  echo "unknown: check whether ${k2n_version} still forwards into a destroyed MessageWriter"
  test_result=1
fi

# The environment the cache depends on. PYTHONNOUSERSITE was once spelled
# `exporot`, which a build cannot catch but this does.
echo -n "Check XDG_CACHE_HOME points at the image cache ... "
test "${XDG_CACHE_HOME}" = "/opt/mccodeantlr-cache" && echo "yes!" || { echo "no: '${XDG_CACHE_HOME:-unset}'"; test_result=1; }
echo -n "Check PYTHONNOUSERSITE is set ... "
test -n "${PYTHONNOUSERSITE:-}" && echo "yes!" || { echo "no!"; test_result=1; }

# The cache itself: populated, and carrying IR sidecars rather than just sources.
echo -n "Check the component cache is populated ... "
n_comp=$(find "${XDG_CACHE_HOME}" -name '*.comp' 2>/dev/null | wc -l)
test "${n_comp}" -gt 100 && echo "yes! (${n_comp} .comp)" || { echo "no: only ${n_comp}"; test_result=1; }
echo -n "Check the IR cache is populated ... "
n_ir=$(find "${XDG_CACHE_HOME}" -name '*.comp.*.json' 2>/dev/null | wc -l)
test "${n_ir}" -gt 100 && echo "yes! (${n_ir} sidecars)" || { echo "no: only ${n_ir}"; test_result=1; }

# Every -R registry named at build time should have landed.
echo -n "Check the extra registries are present ... "
missing=""
for r in mcstas-chopper-lib mccode-mcpl-filter mcstas-detector-cubes mcstas-detector-tubes \
         mcstas-epics-link mcstas-frame-tof-monitor mcstas-monochromator-rowland \
         mcstas-radial-filter-collimator mcstas-slit-radial mcstas-transformer
do
  test -d "${XDG_CACHE_HOME}/mccodeantlr/${r}" || missing="${missing} ${r}"
done
test -z "${missing}" && echo "yes!" || { echo "missing:${missing}"; test_result=1; }

# niess fetches chopper-lib at a version of its own choosing; a baked cache of any other
# version is not consulted, so an offline run would have nothing to build from.
echo -n "Check the cached chopper-lib is the one niess asks for ... "
wanted=$(python -c "from niess.chopcalc.emit import CHOPPER_LIB_REGISTRY as r; print(r.split('@')[1])" 2>&1)
test -d "${XDG_CACHE_HOME}/mccodeantlr/mcstas-chopper-lib/${wanted}" \
  && echo "yes! (${wanted})" \
  || { echo "no: niess asks for '${wanted}', the image has v{{ mcstas_chopper_lib_version }}"; test_result=1; }

# The helper, including that its stdout is a bare path fit for $( ).
test_help splitrun-cache-seed || test_result=1
echo -n "Check splitrun-cache-seed seeds a writable copy ... "
seeded=$(splitrun-cache-seed -q /tmp/splitrun-cache-seed-test 2>/dev/null)
test "${seeded}" = "/tmp/splitrun-cache-seed-test" -a -d "${seeded}/mccodeantlr" \
  && echo "yes!" || { echo "no: got '${seeded}'"; test_result=1; }
rm -rf /tmp/splitrun-cache-seed-test

exit ${test_result}
